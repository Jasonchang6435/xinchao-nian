# Copy to ombre.env only for the local Docker lab; in Zeabur paste into ombre.
ZBPACK_DOCKERFILE_PATH=Dockerfile.ombre
OMBRE_TRANSPORT=streamable-http
OMBRE_PORT=8000
OMBRE_BUCKETS_DIR=/app/buckets
OMBRE_CONFIG_PATH=/app/buckets/config.yaml
OMBRE_MCP_REQUIRE_AUTH=true
OMBRE_MCP_SERVICE_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_64_HEX
OMBRE_DASHBOARD_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_64_HEX
OMBRE_COMPRESS_API_KEY=
OMBRE_COMPRESS_BASE_URL=https://api.deepseek.com/v1
OMBRE_COMPRESS_MODEL=deepseek-chat
OMBRE_EMBED_BACKEND=api
OMBRE_EMBED_API_KEY=
OMBRE_EMBED_BASE_URL=
OMBRE_EMBED_MODEL=
OMBRE_GROW_DEDUPE_SECONDS=21600
# Local Docker uses xinchao; Zeabur uses the actual private hostname shown there.
DYNAMIC_MIND_URL=http://xinchao:18110
DYNAMIC_MIND_TOKEN=REPLACE_WITH_SAME_VALUE_AS_HEART_SERVICE_TOKEN
