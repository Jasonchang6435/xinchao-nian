# Copy to xinchao.env only for the local Docker lab; in Zeabur paste into xinchao.
ZBPACK_DOCKERFILE_PATH=Dockerfile
PORT=18110
SERVICE_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_64_HEX
# Local Docker uses ombre; Zeabur uses the actual private hostname shown there.
OMBRE_MCP_URL=http://ombre:8000/mcp
OMBRE_MCP_TOKEN=REPLACE_WITH_SAME_VALUE_AS_OB_SERVICE_TOKEN
OMBRE_READ_ENABLED=true
CONTEXT_OMBRE_ENABLED=true
OMBRE_WRITE_ENABLED=false
SHADOW_MODE=true
MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
MCP_ENABLED=false
OAUTH_ENABLED=false
# On Zeabur use https://your-new-heart.zeabur.app (no /mcp suffix).
OAUTH_PUBLIC_BASE_URL=https://your-new-heart.zeabur.app
OAUTH_APPROVAL_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_64_HEX
DASHBOARD_ENABLED=true
DASHBOARD_PUBLIC_BASE_URL=http://localhost:18110
DASHBOARD_ACCESS_TOKEN=REPLACE_WITH_INDEPENDENT_RANDOM_64_HEX
DASHBOARD_ALLOWED_ORIGINS=https://xinchaomind.uk
DASHBOARD_INCLUDE_PRIVATE_TEXT=false
STATE_PATH=/app/state/state.json
PERSONALITY_PATH=/app/state/personality.json
TRANSITION_JOURNAL_PATH=/app/state/transitions.jsonl
OAUTH_STATE_PATH=/app/state/oauth.json
BOX_STATE_PATH=/app/state/black-box.json
CABIN_STATE_PATH=/app/state/cabin.json
BRIDGE_STATE_PATH=/app/state/bridge-queue.json
ATTENTION_ENABLED=false
JEV_SHADOW_ENABLED=false
XINCHAO_BOARD_TOKEN=
