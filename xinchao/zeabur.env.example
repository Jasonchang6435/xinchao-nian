# Copy VALUES into the NEW Zeabur service; replace every secret placeholder.
# Build from repository root with Dockerfile. Mount a NEW volume at /app/state.
PORT=18110
SERVICE_TOKEN=replace-with-first-independent-64-character-random-secret
STATE_PATH=/app/state/state.json
PERSONALITY_PATH=/app/state/personality.json
TRANSITION_JOURNAL_PATH=/app/state/transitions.jsonl
OAUTH_STATE_PATH=/app/state/oauth.json
CABIN_STATE_PATH=/app/state/cabin.json
BOX_STATE_PATH=/app/state/black-box.json
SHADOW_MODE=false
MCP_ENABLED=true
OAUTH_ENABLED=true
OAUTH_PUBLIC_BASE_URL=https://YOUR-NEW-DOMAIN.zeabur.app
OAUTH_APPROVAL_TOKEN=replace-with-second-independent-64-character-random-secret
DASHBOARD_ENABLED=true
DASHBOARD_PUBLIC_BASE_URL=https://YOUR-NEW-DOMAIN.zeabur.app
DASHBOARD_ACCESS_TOKEN=replace-with-third-independent-64-character-random-secret
DASHBOARD_INCLUDE_PRIVATE_TEXT=false
DASHBOARD_ALLOWED_ORIGINS=

# Existing OB stays as-is. Start with the known public HTTPS endpoint.
OMBRE_ADAPTER=ob32
OMBRE_MCP_URL=https://gaoli.zeabur.app/mcp
OMBRE_MCP_EXTRA_URL=https://gaoli.zeabur.app/mcp-extra
OMBRE_AUTH_MODE=token
OMBRE_MCP_TOKEN=replace-with-EXISTING-OB-bearer-token
OMBRE_READ_ENABLED=true
OMBRE_WRITE_ENABLED=true
CONTEXT_OMBRE_ENABLED=true
OMBRE_EMOTION_STAMP=true

# If OB only has OAuth: AUTH_MODE=oauth, TOKEN empty; import the state generated
# by scripts/authorize-ob.mjs, OR configure these three seed values privately.
OMBRE_OAUTH_STATE_PATH=/app/state/ob-oauth.json
OMBRE_OAUTH_CLIENT_ID=
OMBRE_OAUTH_REFRESH_TOKEN=
OMBRE_OAUTH_TOKEN_URL=https://gaoli.zeabur.app/oauth/token
OMBRE_OAUTH_RESOURCE=https://gaoli.zeabur.app/mcp

# Optional human-side star map/detail access. MCP Bearer is NOT this password.
# Without it, the map falls back to MCP pulse; seven-line previews unavailable.
OMBRE_DASHBOARD_BASE_URL=https://gaoli.zeabur.app
OMBRE_DASHBOARD_PASSWORD=
OMBRE_DASHBOARD_SESSION=

# Enable autonomous/model features after the manual bridge is verified.
MODEL_ENABLED=false
MODEL_BASE_URL=https://YOUR-MODEL-ENDPOINT/v1
MODEL_API_KEY=
MODEL_NAME=
DAYTIME_EMERGENCE_ENABLED=false
BARK_ENABLED=false
BRIDGE_ENABLED=false
XINCHAO_BOARD_TOKEN=
SETTLE_TIME_ZONE=Asia/Shanghai
INTERACTION_TIME_ZONE=Asia/Shanghai
ATTENTION_ENABLED=false
