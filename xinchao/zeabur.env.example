# Copy VALUES into the NEW Zeabur service; replace every secret placeholder.
# Build from repository root with Dockerfile. Mount a NEW volume at /app/state.
# Default route uses ONLY independently deployed TEST OB; no live fallback.
DRYRUN=true
PORT=18110
SERVICE_TOKEN=replace-with-first-independent-64-character-random-secret
STATE_PATH=/app/state/state.json
PERSONALITY_PATH=/app/state/personality.json
TRANSITION_JOURNAL_PATH=/app/state/transitions.jsonl
OAUTH_STATE_PATH=/app/state/oauth.json
CABIN_STATE_PATH=/app/state/cabin.json
BOX_STATE_PATH=/app/state/black-box.json
SHADOW_MODE=false
MCP_ENABLED=true
OAUTH_ENABLED=true
OAUTH_PUBLIC_BASE_URL=https://YOUR-NEW-DOMAIN.zeabur.app
OAUTH_APPROVAL_TOKEN=replace-with-second-independent-64-character-random-secret
DASHBOARD_ENABLED=true
DASHBOARD_PUBLIC_BASE_URL=https://YOUR-NEW-DOMAIN.zeabur.app
DASHBOARD_ACCESS_TOKEN=replace-with-third-independent-64-character-random-secret
DASHBOARD_INCLUDE_PRIVATE_TEXT=false
DASHBOARD_ALLOWED_ORIGINS=

# Isolated TEST OB: NEW service + NEW volume, synthetic data only at first.
# Replace this hostname; do not use another alias of the production service.
OMBRE_TEST_MCP_URL=https://YOUR-TEST-OB.zeabur.app/mcp
OMBRE_TEST_MCP_EXTRA_URL=https://YOUR-TEST-OB.zeabur.app/mcp-extra
OMBRE_TEST_AUTH_MODE=oauth
OMBRE_TEST_MCP_TOKEN=
OMBRE_TEST_OAUTH_STATE_PATH=/app/state/ob-test-oauth.json
OMBRE_TEST_OAUTH_CLIENT_ID=
OMBRE_TEST_OAUTH_REFRESH_TOKEN=
OMBRE_TEST_OAUTH_TOKEN_URL=https://YOUR-TEST-OB.zeabur.app/oauth/token
OMBRE_TEST_OAUTH_RESOURCE=https://YOUR-TEST-OB.zeabur.app/mcp
OMBRE_TEST_DASHBOARD_BASE_URL=https://YOUR-TEST-OB.zeabur.app
OMBRE_TEST_DASHBOARD_PASSWORD=
OMBRE_TEST_DASHBOARD_SESSION=
# First deploy read-only. Turn ONLY this flag on to test the full write flow.
OMBRE_TEST_WRITE_ENABLED=false
OMBRE_TEST_DREAM_WRITE_ENABLED=false
OMBRE_TEST_ALLOW_DESTRUCTIVE_WRITES=false
# Independent heart state; live STATE_PATH etc above are ignored in DRYRUN.
TEST_STATE_PATH=/app/state/test/state.json
TEST_PERSONALITY_PATH=/app/state/test/personality.json
TEST_TRANSITION_JOURNAL_PATH=/app/state/test/transitions.jsonl
TEST_OAUTH_STATE_PATH=/app/state/test/oauth.json
TEST_CABIN_STATE_PATH=/app/state/test/cabin.json
TEST_BOX_STATE_PATH=/app/state/test/black-box.json
TEST_BRIDGE_STATE_PATH=/app/state/test/bridge-queue.json

# LIVE OB is ignored while DRYRUN=true. Existing OB stays as-is. Start with the known public HTTPS endpoint.
OMBRE_ADAPTER=ob32
OMBRE_MCP_URL=https://gaoli.zeabur.app/mcp
OMBRE_MCP_EXTRA_URL=https://gaoli.zeabur.app/mcp-extra
OMBRE_AUTH_MODE=oauth
OMBRE_MCP_TOKEN=
OMBRE_READ_ENABLED=true
OMBRE_WRITE_ENABLED=false
# DRYRUN=false selects live, but live writes stay OFF until this second opt-in.
# Enable normal writes only AFTER online recovery and reviewed acceptance.
# Autonomous dream writes and destructive replacements are separate opt-ins.
OMBRE_DREAM_WRITE_ENABLED=false
OMBRE_ALLOW_DESTRUCTIVE_WRITES=false
CONTEXT_OMBRE_ENABLED=true
OMBRE_EMOTION_STAMP=true

# OAuth is the recommended path for the existing OB. Run authorize-ob.mjs on
# YOUR computer and use its private grant to seed the NEW service below, OR
# import the grant file once into the NEW volume. Do not invent a Bearer token.
OMBRE_OAUTH_STATE_PATH=/app/state/ob-oauth.json
OMBRE_OAUTH_CLIENT_ID=
OMBRE_OAUTH_REFRESH_TOKEN=
OMBRE_OAUTH_TOKEN_URL=https://gaoli.zeabur.app/oauth/token
OMBRE_OAUTH_RESOURCE=https://gaoli.zeabur.app/mcp

# Alternative ONLY if the unchanged original OB already accepts static tokens:
# OMBRE_AUTH_MODE=token; OMBRE_MCP_TOKEN=<EXISTING OB static token>

# Optional human-side star map/detail access. MCP Bearer is NOT this password.
# Without it, the map falls back to MCP pulse; seven-line previews unavailable.
OMBRE_DASHBOARD_BASE_URL=https://gaoli.zeabur.app
OMBRE_DASHBOARD_PASSWORD=
OMBRE_DASHBOARD_SESSION=

# Enable autonomous/model features after the manual bridge is verified.
MODEL_ENABLED=false
MODEL_BASE_URL=https://YOUR-MODEL-ENDPOINT/v1
MODEL_API_KEY=
MODEL_NAME=
DAYTIME_EMERGENCE_ENABLED=false
BARK_ENABLED=false
BRIDGE_ENABLED=false
XINCHAO_BOARD_TOKEN=
SETTLE_TIME_ZONE=Asia/Shanghai
INTERACTION_TIME_ZONE=Asia/Shanghai
ATTENTION_ENABLED=false
